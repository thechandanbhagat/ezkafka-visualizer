{
  "name": "ezkafka-visualizer",
  "version": "1.1.0",
  "description": "A modern, user-friendly web application for visualizing and managing Apache Kafka clusters",
  "main": "server.js",
  "bin": {
    "ezkafka-visualizer": "./bin/ezkafka-visualizer.js"
  },
  "keywords": [
    "kafka",
    "visualizer",
    "dashboard",
    "monitoring",
    "cluster",
    "topics",
    "messages",
    "consumer-groups",
    "kafka-ui",
    "kafka-tool",
    "kafka-management",
    "nextjs",
    "real-time"
  ],
  "author": "Chandan Bhagat <chandan@example.com>",
  "license": "MIT",
  "homepage": "https://github.com/thechandanbhagat/ezkafka-visualizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thechandanbhagat/ezkafka-visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/thechandanbhagat/ezkafka-visualizer/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    ".next/BUILD_ID",
    ".next/package.json",
    ".next/*manifest.json",
    ".next/required-server-files.json",
    ".next/release-build.json",
    ".next/server",
    ".next/static",
    "public",
    "bin/ezkafka-visualizer.js",
    "server.js",
    "scripts/access-config.cjs",
    "scripts/release-validation.cjs",
    "README.md",
    "LICENSE",
    "release-runtime.json"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:port": "node dev.js",
    "build": "next build",
    "start": "node server.js",
    "start:dev": "node start.js",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "postbuild": "node scripts/release-validation.cjs --stamp",
    "prepack": "node scripts/release-validation.cjs --staged",
    "release:pack": "node scripts/release-pack.cjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "kafkajs": "^2.2.4",
    "lucide-react": "^0.536.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "^3.1.0",
    "@next/env": "15.5.28"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.31"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "bundleDependencies": [
    "next",
    "@next/env"
  ],
  "optionalDependencies": {
    "sharp": "0.35.5"
  }
}
