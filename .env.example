# EZ Kafka Visualizer Configuration
# Copy this file to .env to customize your deployment

# Application Port Configuration
APP_PORT=3700
HOST_PORT=3700
PORT=3700

# Local launch scripts bind explicitly to loopback; 0.0.0.0 or :: requires authentication.
EZKAFKA_BIND_HOST=127.0.0.1

# Required for Docker, standalone, or shared deployment. Supply real values privately.
# Usernames: 1-64 letters/digits or _.@- ; passwords: 16-1024 characters.
EZKAFKA_ADMIN_USERNAME=
EZKAFKA_ADMIN_PASSWORD=
EZKAFKA_READONLY_USERNAME=
EZKAFKA_READONLY_PASSWORD=
# Set this to the exact browser origin. Use HTTPS for any shared deployment.
# Leave empty for ordinary local npm start/dev; Docker defaults to http://localhost:3700.
EZKAFKA_PUBLIC_ORIGIN=
# Optional absolute settings file path; Docker sets /app/data/settings.json automatically.
# EZKAFKA_CONFIG_PATH=
# EZKAFKA_LOCAL_AUTHORITY is internal to guarded launchers. Never configure it manually.

# Kafka Configuration
KAFKA_BROKERS=kafka:29092
KAFKA_CLIENT_ID=ezkafka-visualizer
KAFKA_CONNECTION_TIMEOUT=3000
KAFKA_REQUEST_TIMEOUT=30000

# For connecting to external Kafka (comment out kafka service in docker-compose.yml)
# KAFKA_BROKERS=localhost:9092
# KAFKA_BROKERS=your-kafka-server:9092

# Kafka Cluster Configuration (when using included Kafka)
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181
